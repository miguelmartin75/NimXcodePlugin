	},
	{
		Identifier = "xcode.lang.odin.builtin";
		Syntax = {
			StartChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_";
			Chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
			Words = (
				align_of,
				append,
				cap,
				delete,
				free,
				len,
				make,
				new,
				offset_of,
				size_of,
				typeid_of
			);
			Type = "xcode.syntax.keyword";
			AltType = "xcode.syntax.identifier";
		};
	},

	{
		Identifier = "xcode.lang.odin";
		Description = "Odin Coloring";
		BasedOn = "xcode.lang.simpleColoring";
		IncludeInMenu = YES;
		UsesCLikeIndentation = YES;
		Name = Odin;
		Syntax = {
			Tokenizer = "xcode.lang.odin.lexer.toplevel";
			IncludeRules = (
				"xcode.lang.odin.package",
				"xcode.lang.odin.import",
				"xcode.lang.odin.struct.declaration",
				"xcode.lang.odin.enum.declaration",
				"xcode.lang.odin.union.declaration",
				"xcode.lang.odin.proc.declaration",
				"xcode.lang.odin.block",
				"xcode.lang.odin.parenexpr",
				"xcode.lang.odin.bracketexpr",
			);
			Type = "xcode.syntax.plain";
			DirtyPreviousRightEdge = YES;
		};
	},
	{
		Identifier = "xcode.lang.odin.lexer.toplevel";
		Syntax = {
			IncludeRules = (
				"xcode.lang.comment",
				"xcode.lang.comment.singleline",
				"xcode.lang.string",
				"xcode.lang.character",
				"xcode.lang.number",
				"xcode.lang.odin.builtin",
				"xcode.lang.odin.identifier",
			);
			Type = "xcode.syntax.plain";
		};
	},
	{
		Identifier = "xcode.lang.odin.lexer";
		Syntax = {
			IncludeRules = (
				"xcode.lang.comment",
				"xcode.lang.comment.singleline",
				"xcode.lang.string",
				"xcode.lang.character",
				"xcode.lang.number",
				"xcode.lang.odin.builtin",
				"xcode.lang.odin.identifier",
			);
			Type = "xcode.syntax.plain";
		};
	},
	{
		Identifier = "xcode.lang.odin.name";
		Syntax = {
			Tokenizer = "xcode.lang.odin.lexer";
			Rules = (
				"xcode.lang.odin.identifier",
			);
			Type = "xcode.syntax.name.other";
		};
	},
	{
		Identifier = "xcode.lang.odin.package";
		Syntax = {
			Tokenizer = "xcode.lang.odin.lexer.toplevel";
			Rules = (
				package,
				"xcode.lang.odin.name",
			);
		};
	},
	{
		Identifier = "xcode.lang.odin.import";
		Syntax = {
			Tokenizer = "xcode.lang.odin.lexer.toplevel";
			Rules = (
				import,
				"xcode.lang.odin.import.alias?",
				"xcode.lang.string",
			);
		};
	},
	{
		Identifier = "xcode.lang.odin.import.alias";
		Syntax = {
			Tokenizer = "xcode.lang.odin.lexer";
			Rules = (
				"xcode.lang.odin.name",
			);
		};
	},
	{
		Identifier = "xcode.lang.odin.declaration.name";
		Syntax = {
			Tokenizer = "xcode.lang.odin.lexer";
			Rules = (
				"xcode.lang.odin.identifier",
			);
			Type = "xcode.syntax.name.type";
		};
	},
	{
		Identifier = "xcode.lang.odin.struct.declaration";
		Syntax = {
			Tokenizer = "xcode.lang.odin.lexer";
			Rules = (
				"xcode.lang.odin.declaration.name",
				"::",
				struct,
			);
			Type = "xcode.syntax.definition.struct";
		};
	},
	{
		Identifier = "xcode.lang.odin.enum.declaration";
		Syntax = {
			Tokenizer = "xcode.lang.odin.lexer";
			Rules = (
				"xcode.lang.odin.declaration.name",
				"::",
				enum,
			);
			Type = "xcode.syntax.definition.enum";
		};
	},
	{
		Identifier = "xcode.lang.odin.union.declaration";
		Syntax = {
			Tokenizer = "xcode.lang.odin.lexer";
			Rules = (
				"xcode.lang.odin.declaration.name",
				"::",
				union,
			);
			Type = "xcode.syntax.definition.struct";
		};
	},
	{
		Identifier = "xcode.lang.odin.proc.declaration";
		Syntax = {
			Tokenizer = "xcode.lang.odin.lexer";
			Rules = (
				"xcode.lang.odin.declaration.name",
				"::",
				proc,
			);
			Type = "xcode.syntax.definition.function";
		};
	},
	{
		Identifier = "xcode.lang.odin.block";
		Syntax = {
			Tokenizer = "xcode.lang.odin.lexer";
			Start = "{";
			End = "}";
			Foldable = YES;
			Recursive = YES;
			IncludeRules = (
				"xcode.lang.odin.import",
				"xcode.lang.odin.struct.declaration",
				"xcode.lang.odin.enum.declaration",
				"xcode.lang.odin.union.declaration",
				"xcode.lang.odin.proc.declaration",
				"xcode.lang.odin.block",
				"xcode.lang.odin.parenexpr",
				"xcode.lang.odin.bracketexpr",
			);
		};
	},
	{
		Identifier = "xcode.lang.odin.parenexpr";
		Syntax = {
			Tokenizer = "xcode.lang.odin.lexer";
			Start = "(";
			End = ")";
			Recursive = YES;
			IncludeRules = (
				"xcode.lang.odin.block",
				"xcode.lang.odin.bracketexpr",
			);
		};
	},
	{
		Identifier = "xcode.lang.odin.bracketexpr";
		Syntax = {
			Tokenizer = "xcode.lang.odin.lexer";
			Start = "[";
			End = "]";
			Recursive = YES;
			IncludeRules = (
				"xcode.lang.odin.block",
				"xcode.lang.odin.parenexpr",
			);
		};
	},
)
